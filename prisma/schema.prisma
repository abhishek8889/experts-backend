generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  male
  female
  other
}

model User {
  id            String         @id @default(uuid())
  firstName     String?
  lastName      String?
  phone         String?        @unique
  gender        Gender?
  age           Int?
  email         String         @unique
  verifiedAt    DateTime?
  passwordHash  String
  isActive      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  userRoles     UserRole[]
  expertProfile ExpertProfile?
  wallet        Wallet?

  @@map("users")

}

model RegisterVerificationOtp {
  id        String   @id @default(uuid())
  email     String?
  phone     String?
  otp       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([otp])
  @@map("register_verification_otp")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

enum PermissionAction {
  read
  create
  update
  delete
}

enum PermissionScope {
  self
  any
}

model Permission {
  id       String             @id @default(uuid())
  resource String
  action   PermissionAction
  scope    PermissionScope
  roles    RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role")
}

model RolePermission {
  roleId       String
  permissionId String
  assignedAt   DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}


enum ExpertProfileStatus {
  verified
  unverified
  suspended
}

model ExpertProfile {
  id                        String              @id @default(uuid())
  userId                    String              @unique
  dob                       DateTime?
  gender                    Gender?
  idVerification            String?
  yearsOfExperience         Int?
  experienceProofDocument   String?
  termsAndConditions        Boolean             @default(false)
  status                    ExpertProfileStatus @default(unverified)
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  user                      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expert_profile")
}


model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet")
}
